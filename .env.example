# LLM API Keys (Optional on startup - fallback to 500+ seed message bank if keys absent)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# LLM Model Configurations (Free-tier friendly defaults)
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free

# Priority / Fallback Chains
LLM_PRIORITY_DIRECTOR=groq,gemini,openrouter
LLM_PRIORITY_WRITER=gemini,groq,openrouter

# Three-Tier Architecture Configuration
BATCH_INTERVAL_SEC=240      # Tier 1 batch refill interval (180-300 seconds, with natural ±40s jitter)
BANK_LOW_WATER=120          # Threshold of unused messages before early batch refill
REACTIVE_CALLS=on           # on | off - Allows Tier 2 micro-calls for novel/absurd moments (max 1/90s, 20/hr)
T_HIGH=6.2                  # Hype moment trigger threshold
T_LOW=3.8                   # Hype moment decay/end threshold

# Redis State & Storage
REDIS_URL=redis://localhost:6379

# Server and GraphQL Endpoints
PORT=3002
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:3002/api/graphql
NEXT_PUBLIC_GRAPHQL_WS_URL=ws://localhost:3002/graphql
